CPUUSE 2
##############################
#SAAC基本参数设置
# 帐户服务器端口
port 10001

# SAAC服务器密码
pass test

# rotale_internal
rotale_internal 1000

# dbdir文件目录
dbdir data

# LOG文件目录
logdir log

# LOCK文件目录
lockdir lock

# CHAR文件目录
chardir char

# CHAR_SLEEP文件目录
sleepchardir char_sleep

# WKLOG文件目录
wklogdir data/wklog

# MAIL文件目录
maildir mail

# family文件目录
familydir data/family

# fmpoint文件目录
fmpointdir data/fmpointdir

# fmsmemo文件目录
fmsmemodir data/fmsmemodir

# SA名称
SANAME Test

# LSADDRESS
LSADDRESS localhost

# LS端口
LSPORT 3334

# TEST名称
TESTNAME Test

# OACBIND
OACBIND

# 星系名称
saacname Test

##############################
# 更新人物点数间隔, 单位:秒
Total_Charlist 3600
# 更新进期邮件间隔, 单位:秒
Expired_mail 600
# 删除家族成员间隔, 单位:秒
Del_Family_or_Member 3600
# 更新家族信息间隔, 单位:秒
Write_Family 600

##############################
#MYSQL基本配置
#sql服务器HOST
sql_IP          127.0.0.1
#sql服务器PORT
sql_Port        3306
#sql服务器账号
sql_ID          root
#sql服务器密码
sql_PS          samysql
#sql数据库名
sql_DataBase    sa
#sql人物信息表
sql_Table       CSAlogin
#sql用户名字
sql_NAME        username
#sql密码字段
sql_PASS        password
#sql锁定账号表
sql_LOCK        LOCK

########后台功能############
#是否开启后台功能
openbackground  1
# openbackground==1, 则开启以下功能
sql_RegIP       IP
sql_RegTime     RegTime
sql_LoginTime   LoginTime
sql_Path        Path
sql_OnlineName  OnlineName
# 禁止多少天未上线的账号登陆
uLoginDay        60
# 是否限制同一IP登陆次数(0为不限制)
SameIpMun        0
# 是否使用MD5(0为否1为是)
USEMD5           0
# 每隔几天自动备份一次数据
AUTOBACKUPDAY    1   
# 几点进行自动备份
AUTOBACKUPHOUR   2  
#是否自动注册
AutoReg          0
# 六合彩间格时长墿
LOTTERYSYSTEM    1000
# 充值积分倍数
DoublePayPoint   1
#IP验证
ip1 127.0.0.1
ip2 127.0.0.2
ip3 127.0.0.3
ip4 127.0.0.4
ip5 127.0.0.5
savezip  1
